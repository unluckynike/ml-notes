  "cards": [
    { "dot": "cyan", "title": "为什么双路必死单路", "items": [ "BM25 命中关键词但不懂同义改写", "向量召回懂语义但可能漏掉专有名词", "RRF 只认名次不认分数，把两路信号拧成一路" ] },
    { "dot": "emerald", "title": "重排是最便宜的一环", "items": [ "召回可以粗糙（要快），重排精而少（只排几十条）", "交叉编码器逐对精算，价格换精度", "正文第五节：省下的是「答非所问」的下游成本" ] },
