    { "id": "rm-init", "from": "sft", "to": "rm", "label": "权重初始化", "classification": "复用预训练表征", "variant": "default" },
    { "id": "actor-init", "from": "sft", "to": "ppo", "label": "actor 初始化", "classification": "策略起点", "variant": "emphasis", "route": "straight" },
