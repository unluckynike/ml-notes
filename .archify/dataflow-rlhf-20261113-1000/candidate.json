    { "id": "serve", "from": "aligned", "to": "users", "label": "线上对话", "classification": "推理服务", "variant": "default", "route": "straight" },
    { "id": "flywheel", "from": "users", "to": "prefs", "label": "新偏好对 · 飞轮", "classification": "迭代回流", "variant": "dashed", "route": "bottom-channel" }
